  4136     8007  3F8F               	dw	16271
  4137                           
  4138                           ;Config register CONFIG2 @ 0x8008
  4139                           ;	Master Clear Enable bit
  4140                           ;	MCLRE = ON, MCLR pin is Master Clear function
  4141                           ;	Power-up Timer Enable bit
  4142                           ;	PWRTE = OFF, PWRT disabled
  4143                           ;	Low-Power BOR enable bit
  4144                           ;	LPBOREN = OFF, ULPBOR disabled
  4145                           ;	Brown-out reset enable bits
  4146                           ;	BOREN = ON, Brown-out Reset Enabled, SBOREN bit is ignored
  4147                           ;	Brown-out Reset Voltage Selection
  4148                           ;	BORV = LO, Brown-out Reset Voltage (VBOR) set to 1.9V on LF, and 2.45V on F Devices
  4149                           ;	Zero-cross detect disable
  4150                           ;	ZCD = OFF, Zero-cross detect circuit is disabled at POR.
  4151                           ;	Peripheral Pin Select one-way control
  4152                           ;	PPS1WAY = ON, The PPSLOCK bit can be cleared and set only once in software
  4153                           ;	Stack Overflow/Underflow Reset Enable bit
  4154                           ;	STVREN = ON, Stack Overflow or Underflow will cause a reset
