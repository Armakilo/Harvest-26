  8049                           
  8050                           ;Config register CONFIG1 @ 0x8007
  8051                           ;	External Oscillator mode selection bits
  8052                           ;	FEXTOSC = ECH, EC above 8MHz; PFM set to high power
  8053                           ;	Power-up default value for COSC bits
  8054                           ;	RSTOSC = HFINT32, HFINTOSC with OSCFRQ= 32 MHz and CDIV = 1:1
