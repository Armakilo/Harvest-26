  4124                           ;Config register CONFIG1 @ 0x8007
  4125                           ;	External Oscillator mode selection bits
  4126                           ;	FEXTOSC = ECH, EC above 8MHz; PFM set to high power
  4127                           ;	Power-up default value for COSC bits
  4128                           ;	RSTOSC = HFINT32, HFINTOSC with OSCFRQ= 32 MHz and CDIV = 1:1
  4129                           ;	Clock Out Enable bit
  4130                           ;	CLKOUTEN = OFF, CLKOUT function is disabled; i/o or oscillator function on OSC2
  4131                           ;	Clock Switch Enable bit
  4132                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  4133                           ;	Fail-Safe Clock Monitor Enable bit
  4134                           ;	FCMEN = ON, FSCM timer enabled
