  8275                           ;Config register CONFIG1 @ 0x8007
  8276                           ;	External Oscillator mode selection bits
  8277                           ;	FEXTOSC = ECH, EC above 8MHz; PFM set to high power
  8278                           ;	Power-up default value for COSC bits
  8279                           ;	RSTOSC = HFINT32, HFINTOSC with OSCFRQ= 32 MHz and CDIV = 1:1
  8280                           ;	Clock Out Enable bit
  8281                           ;	CLKOUTEN = OFF, CLKOUT function is disabled; i/o or oscillator function on OSC2
  8282                           ;	Clock Switch Enable bit
  8283                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  8284                           ;	Fail-Safe Clock Monitor Enable bit
  8285                           ;	FCMEN = ON, FSCM timer enabled
  8286     8007                     	org	32775
  8287     8007  3F8F               	dw	16271
  8288                           
  8289                           ;Config register CONFIG2 @ 0x8008
  8290                           ;	Master Clear Enable bit
  8291                           ;	MCLRE = ON, MCLR pin is Master Clear function
  8292                           ;	Power-up Timer Enable bit
  8293                           ;	PWRTE = OFF, PWRT disabled
  8294                           ;	Low-Power BOR enable bit
  8295                           ;	LPBOREN = OFF, ULPBOR disabled
  8296                           ;	Brown-out reset enable bits
  8297                           ;	BOREN = ON, Brown-out Reset Enabled, SBOREN bit is ignored
  8298                           ;	Brown-out Reset Voltage Selection
  8299                           ;	BORV = LO, Brown-out Reset Voltage (VBOR) set to 1.9V on LF, and 2.45V on F Devices
  8300                           ;	Zero-cross detect disable
  8301                           ;	ZCD = OFF, Zero-cross detect circuit is disabled at POR.
  8302                           ;	Peripheral Pin Select one-way control
  8303                           ;	PPS1WAY = ON, The PPSLOCK bit can be cleared and set only once in software
  8304                           ;	Stack Overflow/Underflow Reset Enable bit
  8305                           ;	STVREN = ON, Stack Overflow or Underflow will cause a reset
  8306                           ;	Background Debugger
  8307                           ;	DEBUG = 0x1, unprogrammed default
  8308     8008                     	org	32776
  8309     8008  3FFF               	dw	16383
  8310                           
  8311                           ;Config register CONFIG3 @ 0x8009
  8312                           ;	WDT Period Select bits
  8313                           ;	WDTCPS = WDTCPS_31, Divider ratio 1:65536; software control of WDTPS
  8314                           ;	WDT operating mode
  8315                           ;	WDTE = OFF, WDT Disabled, SWDTEN is ignored
  8316                           ;	WDT Window Select bits
  8317                           ;	WDTCWS = WDTCWS_7, window always open (100%); software control; keyed access not requi
