  8027                           ;Config register CONFIG1 @ 0x8007
  8028                           ;	External Oscillator mode selection bits
  8029                           ;	FEXTOSC = ECH, EC above 8MHz; PFM set to high power
  8030                           ;	Power-up default value for COSC bits
  8031                           ;	RSTOSC = HFINT32, HFINTOSC with OSCFRQ= 32 MHz and CDIV = 1:1
  8032                           ;	Clock Out Enable bit
  8033                           ;	CLKOUTEN = OFF, CLKOUT function is disabled; i/o or oscillator function on OSC2
  8034                           ;	Clock Switch Enable bit
  8035                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
  8036                           ;	Fail-Safe Clock Monitor Enable bit
  8037                           ;	FCMEN = ON, FSCM timer enabled
  8038     8007                     	org	32775
  8039     8007  3F8F               	dw	16271
  8040                           
  8041                           ;Config register CONFIG2 @ 0x8008
  8042                           ;	Master Clear Enable bit
  8043                           ;	MCLRE = ON, MCLR pin is Master Clear function
  8044                           ;	Power-up Timer Enable bit
  8045                           ;	PWRTE = OFF, PWRT disabled
  8046                           ;	Low-Power BOR enable bit
  8047                           ;	LPBOREN = OFF, ULPBOR disabled
  8048                           ;	Brown-out reset enable bits
  8049                           ;	BOREN = ON, Brown-out Reset Enabled, SBOREN bit is ignored
  8050                           ;	Brown-out Reset Voltage Selection
  8051                           ;	BORV = LO, Brown-out Reset Voltage (VBOR) set to 1.9V on LF, and 2.45V on F Devices
  8052                           ;	Zero-cross detect disable
  8053                           ;	ZCD = OFF, Zero-cross detect circuit is disabled at POR.
  8054                           ;	Peripheral Pin Select one-way control
  8055                           ;	PPS1WAY = ON, The PPSLOCK bit can be cleared and set only once in software
  8056                           ;	Stack Overflow/Underflow Reset Enable bit
  8057                           ;	STVREN = ON, Stack Overflow or Underflow will cause a reset
  8058                           ;	Background Debugger
  8059                           ;	DEBUG = 0x1, unprogrammed default
